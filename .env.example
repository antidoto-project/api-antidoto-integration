# Variáveis da API (modelo). Copie para .env só se precisar; o .env nunca vai para o Git.
# No computador nada disso é obrigatório: sem DB_URL, a API usa o H2 em memória.
# No Render, cadastre cada uma em Environment.

# Porta (o Render define sozinho)
PORT=8080

# Banco Postgres do Render (Internal Database URL, no formato JDBC)
DB_URL=jdbc:postgresql://host-do-banco:5432/antidoto
DB_USUARIO=antidoto
DB_SENHA=troque-esta-senha

# Segredo do JWT em base64, com 32+ bytes. Gere com: openssl rand -base64 32
JWT_SECRET=troque-por-um-segredo-em-base64

# Origens do navegador que podem chamar a API (o app no celular não precisa)
CORS_ORIGENS=http://localhost:8081

# false desliga os usuários de teste
CARREGAR_DADOS_INICIAIS=true
